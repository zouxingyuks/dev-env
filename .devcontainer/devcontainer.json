{
  "name": "Personal Devbox",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "devbox",
  "runServices": ["devbox"],
  "overrideCommand": false,
  "workspaceFolder": "/home/dev/items/dev-env",
  "remoteUser": "dev",
  "shutdownAction": "none",
  "customizations": {
    "jetbrains": {
      "plugins": [
        "com.intellij.zh",
        "com.samvtran.plugins.macosforallkeymap",
        "Key Promoter X",
        "com.intellij.minimap",
        "cn.yiiguxing.plugin.translate"
      ]
    }
  }
}
